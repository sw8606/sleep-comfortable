rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users/{uid}/places/{placeId}
    // Document ID: "학교" or "집"
    // Fields:
    //   - uid: string (required, immutable, == auth.uid)
    //   - name: string (required, "학교" or "집", == placeId)
    //   - mode: string (required, "bus" or "subway")
    //   - label: string (required, 1-80 chars)
    //   - lat: number (required)
    //   - lng: number (required)
    //   - lineId: string (optional, subway, <= 20)
    //   - lineName: string (optional, subway, <= 40)
    //   - boardName: string (optional, subway, <= 40)
    //   - destName: string (optional, subway, <= 40)
    //   - hops: number (optional, subway, 1-200)
    //   - updatedAt: timestamp (optional)
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidPlace(data) {
      return data.keys().hasOnly([
          'uid', 'name', 'mode', 'label', 'lat', 'lng',
          'lineId', 'lineName', 'boardName', 'destName', 'hops', 'updatedAt'
        ]) &&
        data.uid is string && data.uid == request.auth.uid &&
        data.name is string && data.name in ['학교', '집'] &&
        data.mode is string && data.mode in ['bus', 'subway'] &&
        data.label is string && data.label.size() >= 1 && data.label.size() <= 80 &&
        data.lat is number && data.lng is number &&
        (data.mode == 'bus' || (
          data.lineId is string && data.lineId.size() >= 1 && data.lineId.size() <= 20 &&
          data.lineName is string && data.lineName.size() >= 1 && data.lineName.size() <= 40 &&
          data.boardName is string && data.boardName.size() >= 1 && data.boardName.size() <= 40 &&
          data.destName is string && data.destName.size() >= 1 && data.destName.size() <= 40 &&
          data.hops is number && data.hops >= 1 && data.hops <= 200
        ));
    }

    match /users/{userId}/places/{placeId} {
      allow read, delete: if isOwner(userId);

      allow create: if isOwner(userId) &&
        placeId in ['학교', '집'] &&
        isValidPlace(request.resource.data) &&
        request.resource.data.name == placeId;

      allow update: if isOwner(userId) &&
        isValidPlace(request.resource.data) &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.name == resource.data.name &&
        request.resource.data.name == placeId;
    }
  }
}
