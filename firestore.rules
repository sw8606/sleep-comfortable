rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidPlace(data) {
      return data.keys().hasOnly([
          'uid', 'name', 'mode', 'label', 'lat', 'lng',
          'lineId', 'lineName', 'destName', 'wakeBefore', 'destId',
          'boardName', 'hops', 'boardLat', 'boardLng',
          'routeId', 'routeName', 'boardId', 'updatedAt'
        ]) &&
        data.uid is string && data.uid == request.auth.uid &&
        data.name is string && data.name in ['학교', '직장', '집'] &&
        data.mode is string && data.mode in ['bus', 'subway'] &&
        data.label is string && data.label.size() >= 1 && data.label.size() <= 80 &&
        data.lat is number && data.lng is number &&
        data.destName is string && data.destName.size() >= 1 && data.destName.size() <= 40 &&
        data.wakeBefore is number && data.wakeBefore >= 1 && data.wakeBefore <= 5 &&
        (!('destId' in data) || data.destId is number) &&
        (!('routeId' in data) || (data.routeId is string && data.routeId.size() >= 1 && data.routeId.size() <= 20)) &&
        (!('routeName' in data) || (data.routeName is string && data.routeName.size() >= 1 && data.routeName.size() <= 40)) &&
        (data.mode == 'bus' || (
          data.lineId is string && data.lineId.size() >= 1 && data.lineId.size() <= 20 &&
          data.lineName is string && data.lineName.size() >= 1 && data.lineName.size() <= 40
        ));
    }

    function isValidHistory(data) {
      return data.keys().hasOnly([
          'uid', 'id', 'mode', 'label', 'lat', 'lng',
          'lineId', 'lineName', 'destName', 'wakeBefore', 'destId',
          'routeId', 'routeName', 'usedAt'
        ]) &&
        data.uid is string && data.uid == request.auth.uid &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 80 &&
        data.mode is string && data.mode in ['bus', 'subway'] &&
        data.label is string && data.label.size() >= 1 && data.label.size() <= 80 &&
        data.lat is number && data.lng is number &&
        data.destName is string && data.destName.size() >= 1 && data.destName.size() <= 40 &&
        data.wakeBefore is number && data.wakeBefore >= 1 && data.wakeBefore <= 5 &&
        data.usedAt is number &&
        (!('destId' in data) || data.destId is number) &&
        (!('routeId' in data) || (data.routeId is string && data.routeId.size() >= 1 && data.routeId.size() <= 20)) &&
        (!('routeName' in data) || (data.routeName is string && data.routeName.size() >= 1 && data.routeName.size() <= 40)) &&
        (data.mode == 'bus' || (
          data.lineId is string && data.lineId.size() >= 1 && data.lineId.size() <= 20 &&
          data.lineName is string && data.lineName.size() >= 1 && data.lineName.size() <= 40
        ));
    }

    match /users/{userId}/places/{placeId} {
      allow read, delete: if isOwner(userId);

      allow create: if isOwner(userId) &&
        placeId in ['학교', '직장', '집'] &&
        isValidPlace(request.resource.data) &&
        request.resource.data.name == placeId;

      allow update: if isOwner(userId) &&
        isValidPlace(request.resource.data) &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.name == resource.data.name &&
        request.resource.data.name == placeId;
    }

    match /users/{userId}/history/{itemId} {
      allow read, delete: if isOwner(userId);

      allow create: if isOwner(userId) &&
        isValidHistory(request.resource.data) &&
        request.resource.data.id == itemId;

      allow update: if isOwner(userId) &&
        isValidHistory(request.resource.data) &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.id == itemId;
    }
  }
}
